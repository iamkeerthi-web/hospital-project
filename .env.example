# Flask application configuration
FLASK_ENV=development
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000

# Security (change SECRET_KEY in production)
SECRET_KEY=change-this-to-a-strong-random-secret-key
AUTH_TOKEN_TTL_SECONDS=86400

# SQLite Database
DATABASE_PATH=smart_queue.db

# Queue & Token settings
TOKEN_EXPIRY_MINS=30
DEFAULT_CONSULT_MINS=7

# CORS
CORS_ORIGINS=*

# Initial Admin Seed Credentials (change before deploying)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_EMAIL=admin@smartqueue.local
DEFAULT_STAFF_USERNAME=staff
DEFAULT_STAFF_PASSWORD=Staff@123
